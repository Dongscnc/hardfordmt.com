---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageTitle from '../components/PageTitle.astro';
import ProductCard from '../components/ProductCard.astro';
import InquiryForm from '../components/InquiryForm.astro';
const cats = [
  { id: 'horizontal', label: 'Horizontal Lathe Center', models: ['TCK52','TCK600','TCK700','TCK800','TCK1000'] },
  { id: 'multi-axis',  label: 'Multi-Axis Lathe Center',  models: ['TCK52D','TCK600DY','TCK800DY'] },
  { id: 'multi-function', label: 'Multi-Function Lathe Center', models: ['DTM2000S','DVM3000','VTC1010'] },
  { id: 'flat-bed',    label: 'CNC Flat-Bed Lathe',       models: ['QK1327','CK84160','CK84100'] },
];
---
<BaseLayout title="Equipment Catalog | Hardford">
  <PageTitle title="Equipment Catalog" breadcrumb={[{label:'Home', href:'/'},{label:'Catalog'}]} />
  <section class="py-12 bg-gray-100 border-y border-gray-300">
    <div class="max-w-7xl mx-auto px-4 grid md:grid-cols-[240px_1fr] gap-8">
      <aside class="md:sticky md:top-32 self-start">
        <div class="bg-navy text-white p-4 mb-3 border-b-4 border-accent">
          <h3 class="text-sm font-extrabold uppercase tracking-widest">Categories</h3>
        </div>
        <select class="w-full md:hidden border-2 border-navy rounded-none px-3 py-2 mb-4 bg-white font-bold">
          <option>All Categories</option>
          {cats.map(c => <option>{c.label}</option>)}
        </select>
        <ul class="hidden md:block border-2 border-navy bg-white divide-y divide-gray-200">
          {cats.map(c => <li><a href={`#${c.id}`} class="block px-4 py-3 text-sm text-gray-800 font-bold uppercase hover:bg-navy hover:text-white transition">{c.label}</a></li>)}
          <li><a href="#5-axis"  class="block px-4 py-3 text-sm text-gray-800 font-bold uppercase hover:bg-navy hover:text-white transition">5-Axis Turning-Milling</a></li>
          <li><a href="#vmc"     class="block px-4 py-3 text-sm text-gray-800 font-bold uppercase hover:bg-navy hover:text-white transition">5-Axis Machining Center</a></li>
          <li><a href="#gantry"  class="block px-4 py-3 text-sm text-gray-800 font-bold uppercase hover:bg-navy hover:text-white transition">Gantry Machining Center</a></li>
        </ul>
      </aside>
      <div class="space-y-12">
        {cats.map(c => (
          <section id={c.id}>
            <div class="bg-navy text-white px-5 py-3 mb-4 border-l-4 border-accent">
              <h3 class="text-lg font-extrabold uppercase tracking-wider">{c.label}</h3>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-0 border-2 border-navy shadow-lg bg-white">
              {c.models.map((m, i) => (
                <div class={i < c.models.length - 1 ? 'border-r border-gray-200' : ''}>
                  <ProductCard model={m} href={`/products/${m.toLowerCase()}`} />
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>
  <InquiryForm />
</BaseLayout>