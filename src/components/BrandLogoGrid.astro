---
const brands = [
  'HEIDENHAIN','FANUC','SIEMENS','SYNTEC','GSK',
  'THK','NSK','NACHI','SKF','SCHNEIDER',
];
---
<section class="py-16 bg-gray-100 border-y border-gray-300">
  <div class="max-w-7xl mx-auto px-4">
    <div class="text-center mb-10">
      <div class="inline-block w-12 h-1 bg-accent mb-3"></div>
      <h2 class="text-3xl md:text-4xl font-extrabold text-navy uppercase tracking-wide mb-3">Our Partners</h2>
      <p class="text-gray-700 max-w-3xl mx-auto">Trusted by leading enterprises. Our products are exported to 56 countries.</p>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-0 border-2 border-navy bg-white shadow-xl">
      {brands.map((b, i) => (
        <div class={`aspect-square placeholder-logo flex items-center justify-center font-extrabold text-lg ${i % 5 < 4 ? 'border-r border-gray-200' : ''} ${i < 10 ? 'border-b border-gray-200' : ''}`}>
          {b}
        </div>
      ))}
    </div>
  </div>
</section>