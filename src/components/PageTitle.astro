---
const { title, subtitle = 'Hardford CNC Equipment Co., Ltd.', breadcrumb = [] } = Astro.props;
---
<section class="relative py-16 bg-navy text-white overflow-hidden border-b-4 border-accent">
  <div class="absolute inset-0 bg-black/40"></div>
  <div class="relative max-w-7xl mx-auto px-4">
    {breadcrumb.length > 0 && (
      <nav class="text-sm text-gray-300 mb-4">
        {breadcrumb.map((b: {label: string, href?: string}, i: number) => (
          <span>
            {b.href ? <a href={b.href} class="hover:text-accent">{b.label}</a> : <span class="text-accent">{b.label}</span>}
            {i < breadcrumb.length - 1 && <span class="mx-2 text-gray-500">›</span>}
          </span>
        ))}
      </nav>
    )}
    <div class="inline-block w-12 h-1 bg-accent mb-3"></div>
    <h2 class="text-sm md:text-base font-bold text-accent uppercase tracking-widest mb-2">{subtitle}</h2>
    <h1 class="text-4xl md:text-5xl font-extrabold uppercase tracking-wide">{title}</h1>
  </div>
</section>