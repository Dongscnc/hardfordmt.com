---
const stats = [
  { number: '40+', label: 'Years CNC Experience' },
  { number: '40',  label: 'Acres Facility' },
  { number: '56+', label: 'Countries Exported' },
  { number: 'ISO 9001', label: 'Quality Certified' },
];
---
<section class="relative bg-cover bg-center py-16 border-y-4 border-accent" style="background-image: url('https://via.placeholder.com/1920x400/2a2a2a/333333?text=Factory+Aerial+View')">
  <div class="absolute inset-0 bg-black/75"></div>
  <div class="relative max-w-7xl mx-auto px-4 grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
    {stats.map(s => (
      <div class="border-2 border-accent/40 p-6 bg-black/40 backdrop-blur-sm">
        <div class="text-5xl md:text-7xl font-extrabold text-accent mb-2 leading-none">{s.number}</div>
        <div class="text-xs md:text-sm tracking-widest uppercase text-white font-semibold">{s.label}</div>
      </div>
    ))}
  </div>
</section>