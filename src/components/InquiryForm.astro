---
---
<section id="inquiry" class="relative py-20 text-white overflow-hidden border-y-4 border-accent">
  <div class="absolute inset-0 placeholder-img bg-gradient-to-br from-navy via-navy-light to-navy"></div>
  <div class="absolute inset-0 bg-black/40"></div>
  <div class="relative max-w-6xl mx-auto px-4 grid md:grid-cols-[40%_60%] gap-10 items-center">
    <div class="text-center md:text-left">
      <div class="inline-block w-12 h-1 bg-accent mb-3"></div>
      <h2 class="text-3xl md:text-4xl font-extrabold uppercase tracking-wide mb-4 leading-tight">We'll Help You Choose The Right Equipment</h2>
      <p class="text-gray-200 text-lg">Leave a request and we will contact you shortly</p>
      <div class="mt-6 hidden md:block space-y-2 text-sm text-gray-300">
        <div>📞 +86-13371109792</div>
        <div>✉️ info@hardfordmt.com</div>
        <div>💬 WeChat: hardford_cnc</div>
      </div>
    </div>
    <form class="bg-white/10 backdrop-blur-sm border-2 border-accent/50 p-6 grid grid-cols-1 md:grid-cols-2 gap-3 shadow-2xl">
      <input type="text"  placeholder="Your name"  class="bg-white text-dark px-4 py-3 focus:outline-none focus:ring-2 focus:ring-accent" required />
      <input type="tel"   placeholder="Your phone" class="bg-white text-dark px-4 py-3 focus:outline-none focus:ring-2 focus:ring-accent" required />
      <input type="email" placeholder="Email"      class="bg-white text-dark px-4 py-3 md:col-span-2 focus:outline-none focus:ring-2 focus:ring-accent" required />
      <textarea placeholder="Message" rows="3" class="bg-white text-dark px-4 py-3 md:col-span-2 focus:outline-none focus:ring-2 focus:ring-accent"></textarea>
      <button type="submit" class="md:col-span-2 bg-accent hover:bg-accent-dark text-white font-bold py-3 uppercase tracking-widest transition">Request a Quote →</button>
    </form>
  </div>
</section>