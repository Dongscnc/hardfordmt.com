---
const services = [
  { icon: '💡', title: 'Technical Consulting', desc: 'Pre-sales advice on machine selection and process planning.' },
  { icon: '🚀', title: 'Installation & Commissioning', desc: 'On-site setup, calibration and operator training.' },
  { icon: '🔧', title: 'Machine Repair', desc: 'Lifetime maintenance support and spare parts supply.' }
];
---
<section class="py-12 bg-brand-50">
  <div class="max-w-7xl mx-auto px-4">
    <div class="text-center mb-8">
      <h2 class="text-2xl md:text-3xl font-bold text-brand-700 mb-2">Full Lifecycle Warranty</h2>
      <p class="text-gray-600">Consulting and technical support throughout the entire equipment lifetime</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {services.map(s => (
        <div class="bg-white p-6 rounded-lg shadow-sm text-center">
          <div class="text-5xl mb-3">{s.icon}</div>
          <h3 class="font-bold text-brand-700 mb-2">{s.title}</h3>
          <p class="text-sm text-gray-600">{s.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>