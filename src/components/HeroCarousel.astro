---
const slides = [
  { tag: 'PIONEER OF CNC INDUSTRY', h1: 'Heavy-Duty Horizontal Lathe', sub: '30 Years of Manufacturing Excellence', img: 'Hardford CNC Lathe Workshop' },
  { tag: 'HIGH PRECISION',          h1: 'Multi-Axis Turning Center', sub: '5-Axis Simultaneous Machining',       img: '5-Axis CNC Machining Center' },
  { tag: 'PIPE & THREAD SPECIALIST',h1: 'CNC Flat-Bed Lathe',       sub: 'Long Workpiece Expert',                  img: 'Flat-Bed CNC Lathe for Pipes' },
  { tag: 'LONG SHAFT EXPERT',       h1: 'Horizontal Turning Center',sub: 'High Rigidity & Stability',              img: 'Horizontal Turning Center' },
];
---
<section class="relative h-[560px] md:h-[680px] overflow-hidden">
  <div id="hero-slider" class="absolute inset-0">
    {slides.map((s, i) => (
      <div class={`hero-slide absolute inset-0 transition-opacity duration-1000 ${i === 0 ? 'opacity-100' : 'opacity-0'}`} data-index={i}>
        <!-- Background image placeholder, full-bleed -->
        <div class="absolute inset-0 placeholder-img bg-gradient-to-br from-gray-800 via-gray-700 to-gray-900">
          <div class="absolute inset-0 flex items-center justify-center text-gray-400 text-xl md:text-2xl font-bold">[ {s.img} ]</div>
        </div>
        <!-- Dark overlay -->
        <div class="absolute inset-0 bg-black/55"></div>
        <!-- Top accent stripe -->
        <div class="absolute top-0 left-0 right-0 h-1 bg-accent"></div>
        <!-- Content box -->
        <div class="relative h-full max-w-7xl mx-auto px-4 flex items-center">
          <div class="max-w-2xl border-l-4 border-accent pl-6 md:pl-8">
            <div class="inline-block bg-accent text-white px-3 py-1 mb-4 text-xs font-bold uppercase tracking-widest">{s.tag}</div>
            <h1 class="text-3xl md:text-6xl font-extrabold text-white mb-3 leading-tight uppercase">{s.h1}</h1>
            <h2 class="text-lg md:text-2xl text-gray-200 mb-6 font-light">{s.sub}</h2>
            <a href="#inquiry" class="inline-block bg-accent hover:bg-accent-dark text-white px-8 py-3 font-bold uppercase tracking-wider transition">Request a Quote →</a>
          </div>
        </div>
        <!-- Caption strip -->
        <div class="absolute bottom-0 left-0 right-0 bg-black/60 text-white text-xs md:text-sm py-2">
          <div class="max-w-7xl mx-auto px-4 flex justify-between items-center flex-wrap gap-2">
            <span>📞 +86-13371109792 · ✉️ info@hardfordmt.com</span>
            <span class="text-accent font-semibold">HARDFORD CNC · SHANDONG, CHINA</span>
          </div>
        </div>
      </div>
    ))}
  </div>
  <div class="absolute bottom-14 left-0 right-0 flex justify-center gap-2 z-10">
    {slides.map((_, i) => (
      <button class="hero-dot w-3 h-3 rounded-full bg-white/40 hover:bg-accent" data-index={i}></button>
    ))}
  </div>
</section>
<script>
  const slides = document.querySelectorAll('.hero-slide');
  const dots = document.querySelectorAll('.hero-dot');
  let current = 0;
  function show(i: number) {
    slides.forEach((s, idx) => s.classList.toggle('opacity-100', idx === i));
    slides.forEach((s, idx) => s.classList.toggle('opacity-0', idx !== i));
    dots.forEach((d, idx) => d.classList.toggle('bg-accent', idx === i));
    dots.forEach((d, idx) => d.classList.toggle('bg-white/40', idx !== i));
    current = i;
  }
  dots.forEach((d, i) => d.addEventListener('click', () => show(i)));
  setInterval(() => show((current + 1) % slides.length), 5000);
</script>